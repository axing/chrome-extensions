{
  "manifest_version": 3,
  "name": "Google Meet Auto Join",
  "description": "Adds a panel to the Meet pre-call screen that clicks Join for you at a time you set.",
  "version": "0.0.0",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
